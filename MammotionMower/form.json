{
  "elements": [
    {
      "type": "CheckBox",
      "name": "Active",
      "caption": "Instanz aktiv"
    },
    {
      "type": "ExpansionPanel",
      "name": "StatusPanel",
      "caption": "Status",
      "expanded": true,
      "items": []
    },
    {
      "type": "ExpansionPanel",
      "caption": "Einstellungen",
      "expanded": true,
      "items": [
        {
          "type": "ValidationTextBox",
          "name": "DeviceID",
          "caption": "Device ID (leer = erster Mäher im Konto)",
          "width": "400px"
        },
        {
          "type": "NumberSpinner",
          "name": "PollInterval",
          "caption": "Abfrageintervall",
          "suffix": "Sekunden",
          "minimum": 30
        },
        {
          "type": "CheckBox",
          "name": "EnableTile",
          "caption": "Kachel-Visualisierung (HTML) aktiv"
        },
        {
          "type": "CheckBox",
          "name": "EnableReports",
          "caption": "Statistik, Einsatzverlauf und Fehlerprotokoll abrufen (alle 15 Minuten)"
        }
      ]
    },
    {
      "type": "ExpansionPanel",
      "caption": "Kachel-Hintergrund",
      "expanded": false,
      "items": [
        {
          "type": "Select",
          "name": "TileTheme",
          "caption": "Farbschema der Kachel",
          "options": [
            {
              "caption": "Symcon-Design (Farben der Visualisierung)",
              "value": 0
            },
            {
              "caption": "Dunkel",
              "value": 1
            },
            {
              "caption": "Hell",
              "value": 2
            }
          ]
        },
        {
          "type": "Select",
          "name": "TileBackgroundMode",
          "caption": "Hintergrund",
          "options": [
            {
              "caption": "Schimmer in der Zustandsfarbe (Standard)",
              "value": 0
            },
            {
              "caption": "Bild aus Medienobjekt",
              "value": 1
            },
            {
              "caption": "Keiner (nur Farbschema)",
              "value": 2
            }
          ]
        },
        {
          "type": "SelectMedia",
          "name": "TileBackgroundMedia",
          "caption": "Bild (Medienobjekt)"
        },
        {
          "type": "NumberSpinner",
          "name": "TileBackgroundDim",
          "caption": "Abdunklung des Bildes",
          "suffix": "%",
          "minimum": 0,
          "maximum": 90
        },
        {
          "type": "Label",
          "caption": "Bild als Medienobjekt im Objektbaum anlegen (Objekt hinzufügen → Medien → Bild) und hier auswählen. Empfohlen: JPG oder WebP, höchstens ca. 2 MB. Bei „Transparent“ gilt der Hintergrund, der in der Kachel-Visualisierung für diese Kachel eingestellt ist. Änderungen werden nach dem Übernehmen beim nächsten Öffnen der Kachel sichtbar."
        }
      ]
    },
    {
      "type": "ExpansionPanel",
      "caption": "Steuerung",
      "expanded": true,
      "items": [
        {
          "type": "Label",
          "caption": "Steuerbefehle bewegen einen realen Mähroboter. Erst freigeben, wenn die Werte stimmen, und vor jedem Befehl den Arbeitsbereich prüfen."
        },
        {
          "type": "CheckBox",
          "name": "EnableControl",
          "caption": "Schreibbefehle freigeben (Aufgabe starten, Pause, Stop, Heimfahrt)"
        }
      ]
    }
  ],
  "actions": [
    {
      "type": "Button",
      "caption": "Jetzt aktualisieren",
      "onClick": "echo MAMMO_RefreshWithResult($id);"
    },
    {
      "type": "Label",
      "name": "VersionLabel",
      "caption": "Mammotion Open API"
    }
  ],
  "status": [
    {
      "code": 102,
      "icon": "active",
      "caption": "Aktiv"
    },
    {
      "code": 104,
      "icon": "inactive",
      "caption": "Instanz deaktiviert"
    },
    {
      "code": 200,
      "icon": "error",
      "caption": "Abfrageintervall ungültig (mindestens 30 Sekunden)"
    },
    {
      "code": 201,
      "icon": "error",
      "caption": "API- oder Cloudfehler, Details unter Status"
    },
    {
      "code": 202,
      "icon": "error",
      "caption": "Mäher im Mammotion-Konto nicht gefunden"
    },
    {
      "code": 203,
      "icon": "error",
      "caption": "Cloud-Instanz nicht verbunden, nicht aktiv oder Nutzungshinweis nicht bestätigt"
    }
  ]
}
