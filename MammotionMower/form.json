{
  "elements": [
    {
      "type": "CheckBox",
      "name": "Active",
      "caption": "Instanz aktiv"
    },
    {
      "type": "ExpansionPanel",
      "name": "StatusPanel",
      "caption": "Status",
      "expanded": true,
      "items": []
    },
    {
      "type": "ExpansionPanel",
      "caption": "Einstellungen",
      "expanded": true,
      "items": [
        {
          "type": "ValidationTextBox",
          "name": "DeviceID",
          "caption": "Device ID (leer = erster Mäher im Konto)",
          "width": "400px"
        },
        {
          "type": "NumberSpinner",
          "name": "PollInterval",
          "caption": "Abfrageintervall",
          "suffix": "Sekunden",
          "minimum": 30
        },
        {
          "type": "CheckBox",
          "name": "EnableTile",
          "caption": "Kachel-Visualisierung (HTML) aktiv"
        }
      ]
    },
    {
      "type": "ExpansionPanel",
      "caption": "Steuerung",
      "expanded": true,
      "items": [
        {
          "type": "Label",
          "caption": "Steuerbefehle bewegen einen realen Mähroboter. Erst freigeben, wenn die Werte stimmen, und vor jedem Befehl den Arbeitsbereich prüfen."
        },
        {
          "type": "CheckBox",
          "name": "EnableControl",
          "caption": "Schreibbefehle freigeben (Aufgabe starten, Pause, Stop, Heimfahrt)"
        }
      ]
    }
  ],
  "actions": [
    {
      "type": "Button",
      "caption": "Jetzt aktualisieren",
      "onClick": "echo MAMMO_RefreshWithResult($id);"
    },
    {
      "type": "Label",
      "name": "VersionLabel",
      "caption": "Mammotion Open API"
    }
  ],
  "status": [
    { "code": 102, "icon": "active", "caption": "Aktiv" },
    { "code": 104, "icon": "inactive", "caption": "Instanz deaktiviert" },
    { "code": 200, "icon": "error", "caption": "Abfrageintervall ungültig (mindestens 30 Sekunden)" },
    { "code": 201, "icon": "error", "caption": "API- oder Cloudfehler, Details unter Status" },
    { "code": 202, "icon": "error", "caption": "Mäher im Mammotion-Konto nicht gefunden" },
    { "code": 203, "icon": "error", "caption": "Cloud-Instanz nicht verbunden, nicht aktiv oder Nutzungshinweis nicht bestätigt" }
  ]
}
