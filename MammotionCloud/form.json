{
  "elements": [
    {
      "type": "ExpansionPanel",
      "caption": "Nutzungshinweis",
      "expanded": true,
      "items": [
        {
          "type": "Label",
          "caption": "Privates, inoffizielles Projekt – nicht von Mammotion."
        },
        {
          "type": "Label",
          "caption": "Nutzt die Mammotion Open API mit deinem eigenen Entwicklerzugang. Mammotion kann die API jederzeit ändern oder einschränken."
        },
        {
          "type": "Label",
          "caption": "Steuerbefehle bewegen einen realen Mähroboter. Vor jedem Befehl sicherstellen, dass sich keine Personen, Tiere oder Gegenstände im Arbeitsbereich befinden."
        },
        {
          "type": "CheckBox",
          "name": "NoticeAccepted",
          "caption": "Gelesen – Nutzung auf eigene Verantwortung"
        }
      ]
    },
    {
      "type": "CheckBox",
      "name": "Active",
      "caption": "Instanz aktiv"
    },
    {
      "type": "ExpansionPanel",
      "name": "StatusPanel",
      "caption": "Status",
      "expanded": true,
      "items": []
    },
    {
      "type": "ExpansionPanel",
      "caption": "Zugangsdaten",
      "expanded": true,
      "items": [
        {
          "type": "Label",
          "caption": "Client-ID und Client-Secret der Open-API-Anwendung aus dem Mammotion Developer Portal."
        },
        {
          "type": "ValidationTextBox",
          "name": "ClientID",
          "caption": "Client ID",
          "width": "400px"
        },
        {
          "type": "PasswordTextBox",
          "name": "ClientSecret",
          "caption": "Client Secret",
          "width": "400px"
        }
      ]
    }
  ],
  "actions": [
    {
      "type": "Button",
      "caption": "Verbindung testen",
      "onClick": "echo MAMCLOUD_TestConnection($id);"
    },
    {
      "type": "Button",
      "caption": "Token jetzt erneuern",
      "onClick": "echo MAMCLOUD_RenewToken($id);"
    },
    {
      "type": "Label",
      "name": "VersionLabel",
      "caption": "Mammotion Open API"
    }
  ],
  "status": [
    { "code": 102, "icon": "active", "caption": "Verbunden" },
    { "code": 104, "icon": "inactive", "caption": "Instanz deaktiviert" },
    { "code": 200, "icon": "error", "caption": "Client-ID oder Client-Secret fehlt" },
    { "code": 201, "icon": "error", "caption": "Anmeldung fehlgeschlagen, neuer Versuch nach 10 Minuten, danach seltener" },
    { "code": 202, "icon": "inactive", "caption": "Nutzungshinweis noch nicht bestätigt" }
  ]
}
